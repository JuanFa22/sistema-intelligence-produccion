# Copiá este archivo a .env y completá tu clave (NO subas .env a GitHub)

# --- LLM y embeddings (Gemini) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
# Plan gratuito: pocos workers y muchos reintentos evitan el error 429 (cuota por minuto)
WORKER_CONCURRENCY=2
LLM_MAX_RETRIES=10

# --- RAG (ChromaDB local) ---
# KNOWLEDGE_DIR=knowledge
# CHROMA_DIR=vectorstore
# RAG_TOP_K=4

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Observabilidad: elegí UNA ---
# Opción A (recomendada, local y sin cuenta): Arize Phoenix. Debe estar corriendo en http://localhost:6006
OBSERVABILITY=phoenix
PHOENIX_URL=http://localhost:6006
PHOENIX_PROJECT=sistema-intelligence
# Opción B: LangSmith. Poné OBSERVABILITY= (vacío) y completá lo de abajo
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sistema-intelligence
